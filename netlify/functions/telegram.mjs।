
export default async (request) => {
  const env = process.env;

  if (request.method !== "POST") {
    return new Response("Mayad AI Bot is running!");
  }

  const url = new URL(request.url);

  if (
    !env.WEBHOOK_SECRET ||
    url.searchParams.get("secret") !== env.WEBHOOK_SECRET
  ) {
    return new Response("Forbidden", { status: 403 });
  }

  let update;

  try {
    update = await request.json();
  } catch {
    return new Response("Invalid JSON", { status: 400 });
  }

  const msg = update.message;

  if (!msg?.chat?.id || !msg.text) {
    return new Response("OK");
  }

  const chatId = msg.chat.id;
  const text = msg.text.trim();
  const token = env.TELEGRAM_TOKEN;
  const hfToken = env.HF_TOKEN;

  async function telegram(method, body) {
    return fetch(
      `https://api.telegram.org/bot${token}/${method}`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      }
    );
  }

  async function reply(message) {
    return telegram("sendMessage", {
      chat_id: chatId,
      text: message
    });
  }

  if (text === "/start") {
    await reply(
      "🤖 Welcome to Mayad AI!\n\n" +
      "💬 AI Chat:\n/chat তোমার প্রশ্ন\n\n" +
      "🎨 AI Photo:\n/image ছবির বর্ণনা\n\n" +
      "উদাহরণ:\n/chat বাংলাদেশের রাজধানী কী?\n" +
      "/image a beautiful village in Bangladesh"
    );

    return new Response("OK");
  }

  if (text === "/help") {
    await reply(
      "💬 Chat: /chat তোমার প্রশ্ন\n" +
      "🎨 Photo: /image ছবির বর্ণনা"
    );

    return new Response("OK");
  }

  if (!hfToken) {
    await reply("AI চালু নেই। Netlify-তে HF_TOKEN যোগ করো।");
    return new Response("OK");
  }

  // AI Photo Generator
  if (text.startsWith("/image")) {
    const prompt = text.slice(6).trim();

    if (!prompt) {
      await reply(
        "ছবির বর্ণনা লেখো।\n" +
        "উদাহরণ: /image a beautiful sunset"
      );

      return new Response("OK");
    }

    await reply("🎨 ছবি তৈরি হচ্ছে, একটু অপেক্ষা করো...");

    try {
      const response = await fetch(
        "https://router.huggingface.co/hf-inference/models/black-forest-labs/FLUX.1-schnell",
        {
          method: "POST",
          headers: {
            Authorization: `Bearer ${hfToken}`,
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ inputs: prompt })
        }
      );

      const type = response.headers.get("content-type") || "";

      if (!response.ok || !type.startsWith("image/")) {
        console.error(
          "Image API error:",
          response.status,
          (await response.text()).slice(0, 300)
        );

        await reply(
          "ছবি তৈরি হয়নি। API token, model access ও free credits পরীক্ষা করো।"
        );

        return new Response("OK");
      }

      const image = await response.blob();
      const form = new FormData();

      form.append("chat_id", String(chatId));
      form.append("photo", image, "mayad-ai.jpg");
      form.append("caption", "🎨 Created by Mayad AI");

      const sent = await fetch(
        `https://api.telegram.org/bot${token}/sendPhoto`,
        {
          method: "POST",
          body: form
        }
      );

      if (!sent.ok) {
        await reply("ছবি Telegram-এ পাঠানো যায়নি।");
      }
    } catch (error) {
      console.error("Image error:", error);
      await reply("ছবি তৈরি করতে সমস্যা হয়েছে। পরে আবার চেষ্টা করো।");
    }

    return new Response("OK");
  }

  // AI Chat
  const question = text.startsWith("/chat")
    ? text.slice(5).trim()
    : text;

  if (!question || question.startsWith("/")) {
    await reply("চ্যাট করতে লিখো: /chat তোমার প্রশ্ন");
    return new Response("OK");
  }

  await telegram("sendChatAction", {
    chat_id: chatId,
    action: "typing"
  });

  try {
    const response = await fetch(
      "https://router.huggingface.co/v1/chat/completions",
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${hfToken}`,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          model: env.HF_CHAT_MODEL || "Qwen/Qwen2.5-7B-Instruct",
          messages: [
            {
              role: "system",
              content: "তুমি Mayad AI, একজন সহায়ক AI। সম্ভব হলে বাংলায় উত্তর দাও।"
            },
            {
              role: "user",
              content: question
            }
          ],
          max_tokens: 500
        })
      }
    );

    const data = await response.json();

    if (!response.ok) {
      console.error("Chat API error:", response.status, data);

      await reply(
        "AI উত্তর দিতে পারেনি। Token permission, model access ও credits পরীক্ষা করো।"
      );

      return new Response("OK");
    }

    const answer = data.choices?.[0]?.message?.content;

    if (!answer) {
      await reply("AI থেকে উত্তর পাওয়া যায়নি।");
      return new Response("OK");
    }

    for (let i = 0; i < answer.length; i += 4000) {
      await reply(answer.slice(i, i + 4000));
    }
  } catch (error) {
    console.error("Chat error:", error);
    await reply("সংযোগে সমস্যা হয়েছে। পরে আবার চেষ্টা করো।");
  }

  return new Response("OK");
};
